<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
         http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.objetosperdidos</groupId>
    <artifactId>objetos-perdidos</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
    </properties>

    <dependencies>

        <!-- JavaFX -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>22.0.2</version>
        </dependency>

    </dependencies>

    <build>

        <!-- Nuestra estructura personalizada -->
        <sourceDirectory>src</sourceDirectory>

        <resources>
            <resource>
                <directory>src/front/styles</directory>
                <targetPath>front/styles</targetPath>
            </resource>
        </resources>

       <plugins>

    <!-- Compilador Java -->
    <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>

        <configuration>
            <excludes>
                <exclude>back/DemoPuntos.java</exclude>
            </excludes>
        </configuration>
    </plugin>

    <!-- Ejecutar JavaFX -->
    <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>

        <configuration>
            <mainClass>Main</mainClass>
        </configuration>
    </plugin>

</plugins>

    </build>

</project>